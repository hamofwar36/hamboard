{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "햄보드",
  "version": "1.0.13",
  "identifier": "com.hamboard.desktop",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "햄보드",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "dragDropEnabled": false,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/": ""
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "language": "ko-KR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:hamboard.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MUNDRUUyNjFGMDVDMDkKUldRSlhQQmg0czRjMlpMelJiYWZZU1EyS1hkVEN3aGV2SkZPNFYrekRsY3ByZnZqcFNTNVVXbWYK",
      "endpoints": [
        "https://github.com/hamofwar36/hamboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
