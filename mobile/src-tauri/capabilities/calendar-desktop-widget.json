{
  "identifier": "calendar-desktop-widget",
  "description": "Minimal capability for the standalone calendar desktop widget",
  "windows": [
    "calendar-desktop-widget"
  ],
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "sql:default",
    "core:window:allow-set-always-on-bottom"
  ]
}
