{
  "identifier": "quick-memo-desktop-widget",
  "description": "Minimal capability for standalone quick memo desktop widgets",
  "windows": ["quick-memo-desktop-widget-*"],
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "sql:default",
    "sql:allow-execute",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    {"identifier":"fs:scope","allow":[{"path":"$APPLOCALDATA/assets"},{"path":"$APPLOCALDATA/assets/*"}]}
  ]
}
