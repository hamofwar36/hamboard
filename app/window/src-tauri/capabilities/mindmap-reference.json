{
  "identifier": "mindmap-reference",
  "description": "Mindmap reference window",
  "windows": [
    "mindmap-reference-*"
  ],
  "permissions": [
    "core:window:allow-close",
    "core:event:allow-listen",
    "core:window:allow-set-always-on-top",
    "sql:default",
    "sql:allow-execute",
    "fs:allow-read-file",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPLOCALDATA/assets"
        },
        {
          "path": "$APPLOCALDATA/assets/*"
        }
      ]
    }
  ]
}
