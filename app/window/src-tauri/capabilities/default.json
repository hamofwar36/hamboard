{
  "identifier": "default",
  "description": "Default capability for the Hamboard main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "core:window:allow-is-visible",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-available-monitors",
    "core:window:allow-primary-monitor",
    "core:webview:allow-create-webview-window",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$APPLOCALDATA/sound-packs"
        },
        {
          "path": "$APPLOCALDATA/sound-packs/**"
        }
      ]
    },
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPLOCALDATA/assets"
        },
        {
          "path": "$APPLOCALDATA/assets/*"
        },
        {
          "path": "$APPLOCALDATA/diagnostics"
        },
        {
          "path": "$APPLOCALDATA/diagnostics/*"
        },
        {
          "path": "$APPLOCALDATA/sound-packs"
        },
        {
          "path": "$APPLOCALDATA/sound-packs/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://naver.me/GQGfA3U0"
        },
        {
          "url": "https://github.com/hamofwar36/hamboard"
        }
      ]
    },
    "sql:default",
    "sql:allow-execute"
  ]
}
