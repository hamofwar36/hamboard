{
  "name": "hamboard-tauri",
  "private": true,
  "version": "1.0.13",
  "description": "Hamboard golden HTML wrapped by a minimal Tauri 2 desktop shell",
  "scripts": {
    "tauri": "tauri",
    "frontend:dev": "node scripts/serve.mjs",
    "qa:sync": "node scripts/validate-sync-final.mjs && node scripts/validate-sync-safety.mjs && node scripts/validate-large-backup.mjs && node scripts/validate-paged-backup.mjs && node scripts/validate-sync-pages.mjs",
    "qa:mobile-sync": "node scripts/validate-mobile-sync-model.mjs",
    "qa:project-repository": "node scripts/validate-project-repository.mjs",
    "qa:mobile-project-app": "node scripts/validate-mobile-project-app.mjs",
    "qa:mobile-cloud-sync": "node scripts/validate-mobile-cloud-sync.mjs",
    "qa:editor-widgets": "node scripts/validate-editor-widgets.mjs",
    "qa": "npm run qa:sync && npm run qa:device-handoff && npm run qa:mobile-sync && npm run qa:project-repository && npm run qa:mobile-project-app && npm run qa:mobile-cloud-sync && npm run qa:editor-widgets && npm run qa:theme && npm run qa:six-colors",
    "dev": "tauri dev",
    "build": "tauri build",
    "qa:theme": "node scripts/validate-theme.mjs",
    "qa:six-colors": "node scripts/validate-six-colors.mjs",
    "qa:confirmed-bugs": "node scripts/validate-confirmed-bugs.cjs",
    "qa:sync-safety": "node scripts/validate-sync-safety.mjs",
    "qa:large-backup": "node scripts/validate-large-backup.mjs",
    "qa:paged-backup": "node scripts/validate-paged-backup.mjs",
    "qa:sync-pages": "node scripts/validate-sync-pages.mjs",
    "qa:native-windows": "powershell -NoProfile -File scripts/check-windows-native.ps1",
    "qa:device-handoff": "node scripts/validate-device-handoff.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "2.4.0",
    "@tauri-apps/plugin-updater": "^2.10.1"
  }
}
